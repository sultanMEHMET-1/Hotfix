GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
SENTRY_DSN=
MENDER_HEADLESS=true
MENDER_LOG_LEVEL=INFO
# The default workflow: listed first, and the one whose version the reset reports. Defaults to permit-application.
MENDER_DEMO_WORKFLOW=
# Interpreter for the runner subprocess. Defaults to .venv/bin/python when it exists (it has Playwright).
MENDER_RUNNER_PYTHON=
# Extra hostnames (comma separated) where workflows with "mutates": true may run, besides loopback.
MENDER_WRITE_HOSTS=
