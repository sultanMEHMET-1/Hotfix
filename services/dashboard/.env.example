# Flip to "false" at the hour-15 handshake to hit Person 2's FastAPI.
VITE_USE_MOCKS=true
# Leave empty in dev to use the Vite proxy (/api -> http://localhost:8000).
VITE_API_BASE=
# Sentry org slug for trace deep-links; the button is disabled when unset.
VITE_SENTRY_ORG=
# Browser Sentry (tracing from the click through the backend and agent, plus Session Replay). Off when empty.
VITE_SENTRY_DSN=
# Share of ordinary sessions recorded as Replay (0 to 1). Use 1 while demoing; sessions with an error are always recorded.
VITE_SENTRY_REPLAY_RATE=0.1
